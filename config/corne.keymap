#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&soft_off {
    hold-time-ms = <5000>; // Only turn off it the key is held for 5 seconds or longer.
};

&soft_off { /delete-property/ split-peripheral-off-on-press; };

&mt {
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
    flavor = "hold-preferred";
};

flavor = "

hold-preferred {
    ";};

/

    combos {
        compatible = "zmk,combos";

        exclm {
            bindings = <&kp EXCLAMATION>;
            key-positions = <1 13>;
        };

        at {
            bindings = <&kp AT_SIGN>;
            key-positions = <2 14>;
        };

        hash {
            bindings = <&kp HASH>;
            key-positions = <3 15>;
        };

        dllr {
            bindings = <&kp DOLLAR>;
            key-positions = <4 16>;
        };

        percnt {
            bindings = <&kp PERCENT>;
            key-positions = <5 17>;
        };

        caret {
            bindings = <&kp CARET>;
            key-positions = <6 18>;
        };

        and {
            bindings = <&kp AMPERSAND>;
            key-positions = <7 19>;
        };

        str {
            bindings = <&kp ASTERISK>;
            key-positions = <8 20>;
        };

        leftparen {
            bindings = <&kp LPAR>;
            key-positions = <9 21>;
        };

        rparen {
            bindings = <&kp RPAR>;
            key-positions = <10 22>;
        };

        lshift {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <14 26>;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };

    keymap {
        compatible = "zmk,keymap";

        canary_matrix {
            bindings = <
&none  &kp W           &kp L           &kp Y        &kp P             &kp B      &kp Z      &kp F              &kp O         &kp U            &kp SQT          &none
&none  &mt LEFT_GUI C  &mt LEFT_ALT R  &mt LCTRL S  &mt LEFT_SHIFT T  &kp G      &kp M      &mt RIGHT_SHIFT N  &mt RCTRL E   &mt RIGHT_ALT I  &mt RIGHT_GUI A  &none
&none  &kp Q           &kp J           &kp V        &kp D             &kp K      &kp X      &kp H              &kp COMMA     &kp DOT          &kp FSLH         &none
                                       &kp ESCAPE   &lt 3 SPACE       &kp TAB    &kp ENTER  &lt 2 BACKSPACE    &lt 4 DELETE
            >;

            label = "canary matrix";
        };

        qwerty {
            bindings = <
&trans  &kp Q  &kp W  &kp E   &kp R   &kp T     &kp Y   &kp U   &kp I      &kp O    &kp P     &trans
&trans  &kp A  &kp S  &kp D   &kp F   &kp G     &kp H   &kp J   &kp K      &kp L    &kp SEMI  &trans
&trans  &kp Z  &kp X  &kp C   &kp V   &kp B     &kp N   &kp M   &kp COMMA  &kp DOT  &kp FSLH  &trans
                      &trans  &trans  &trans    &trans  &trans  &trans
            >;

            label = "qwerty";
        };

        num {
            bindings = <
&trans  &kp LEFT_BRACKET  &kp N7        &kp N8        &kp N9        &kp RIGHT_BRACKET    &none   &none            &none      &none          &studio_unlock  &trans
&trans  &kp SEMICOLON     &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp EQUAL            &none   &kp RIGHT_SHIFT  &kp RCTRL  &kp RIGHT_ALT  &kp RIGHT_GUI   &trans
&trans  &kp GRAVE         &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp BSLH             &none   &kp TAB          &none      &none          &none           &trans
                                        &kp PERIOD    &kp N0        &kp MINUS            &trans  &trans           &trans
            >;

            label = "num";
        };

        nav {
            bindings = <
&trans  &kp CAPSLOCK    &kp RC(LEFT_ARROW)  &kp UP_ARROW    &kp LC(RIGHT_ARROW)  &kp PAGE_UP      &msc SCRL_UP    &none              &none      &none          &none          &trans
&trans  &kp LEFT_SHIFT  &kp LEFT_ARROW      &kp DOWN_ARROW  &kp RIGHT_ARROW      &kp PAGE_DOWN    &msc SCRL_DOWN  &kp RIGHT_SHIFT    &kp RCTRL  &kp RIGHT_ALT  &kp RIGHT_GUI  &trans
&trans  &kp LEFT_ALT    &kp HOME            &kp LCTRL       &kp END              &kp INSERT       &none           &kp K_APPLICATION  &none      &none          &none          &trans
                                            &trans          &trans               &trans           &trans          &trans             &trans
            >;

            label = "nav";
        };

        fun {
            bindings = <
&trans  &kp F12  &kp F7  &kp F8  &kp F9     &kp C_VOL_UP    &none  &kp C_VOLUME_DOWN  &kp K_MUTE        &kp C_VOLUME_UP  &kp C_BRIGHTNESS_INC  &trans
&trans  &kp F11  &kp F4  &kp F5  &kp F6     &kp C_MUTE      &none  &kp LEFT_ARROW     &kp DOWN_ARROW    &kp RIGHT        &kp RIGHT_GUI         &trans
&trans  &kp F10  &kp F1  &kp F2  &kp F3     &kp C_VOL_DN    &none  &kp C_PREVIOUS     &kp C_PLAY_PAUSE  &kp C_NEXT       &kp C_BRIGHTNESS_DEC  &trans
                         &to 5   &kp SPACE  &kp TAB         &to 0  &to 1              &trans
            >;

            label = "fun";
        };

        blue {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &bt BT_NXT    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &bt BT_CLR    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &bt BT_PRV    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans        &trans  &trans  &trans
            >;

            label = "bluetooth";
        };
    };
};
